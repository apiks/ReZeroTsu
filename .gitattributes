# Auto detect text files and perform LF normalization
* text=auto

# Go files are LF in the working tree so gofmt works on every checkout
*.go text eol=lf

# Hooks run under sh, which rejects CRLF
.githooks/* text eol=lf

# Scripts run under sh, which rejects CRLF
scripts/*.sh text eol=lf

# Every ticket appends a bullet in the same place; keep both sides of a parallel merge
docs/release-notes.md merge=union
